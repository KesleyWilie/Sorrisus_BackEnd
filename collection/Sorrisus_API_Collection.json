{
  "info": {
    "name": "Sorrisus API - CRUDs",
    "_postman_id": "a5a6c1b2-f93d-4f2e-b91b-1234567890ab",
    "description": "Coleção completa para testar os CRUDs e Auth do sistema Sorrisus.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (gerar token JWT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if(json.accessToken){",
                  "   pm.collectionVariables.set(\"token\", json.accessToken);",
                  "   console.log(\"Token atualizado com sucesso!\");",
                  "} else {",
                  "   console.log(\"Nenhum token encontrado na resposta.\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@sorrisus.com\",\n  \"password\": \"admin123\"\n}"
            },
            "url": "{{base_url}}/api/auth/login"
          }
        }
      ]
    },

    {
      "name": "🧍 Usuário",
      "item": [
        {
          "name": "Listar usuários",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/api/usuarios"
