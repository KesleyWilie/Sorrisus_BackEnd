    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (gerar token JWT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if(json.accessToken){",
                  "   pm.collectionVariables.set(\"token\", json.accessToken);",
                  "   console.log(\"Token atualizado com sucesso!\");",
                  "} else {",
                  "   console.log(\"Nenhum token encontrado na resposta.\");",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ana.paula@sorrisus.com\",\n  \"password\": \"senhaSegura123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          },
          "response": []
        }
      ]
