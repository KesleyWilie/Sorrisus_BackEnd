  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (gerar token JWT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if(json.accessToken){",
                  "   pm.collectionVariables.set(\"token\", json.accessToken);",
                  "   console.log(\"Token atualizado com sucesso!\");",
                  "} else {",
                  "   console.log(\"Nenhum token encontrado na resposta.\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@sorrisus.com\",\n  \"password\": \"admin123\"\n}"
            },
            "url": "{{base_url}}/api/auth/login"
          }
        }
      ]
    },
