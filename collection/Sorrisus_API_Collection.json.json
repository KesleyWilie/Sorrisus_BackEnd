{
  "info": {
    "name": "Sorrisus API",
    "_postman_id": "c2b5b987-44a9-4c02-9e03-d0c5c877a000",
    "description": "Coleção para testar a API do Sistema Sorrisus com autenticação JWT.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "jwt",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Registrar Usuário",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Admin Sorrisus\",\n  \"email\": \"admin@sorrisus.com\",\n  \"senha\": \"admin123\",\n  \"role\": \"ROLE_RECEPCIONISTA\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Login (gerar token JWT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if(json.accessToken){",
                  "   pm.collectionVariables.set(\"jwt\", json.accessToken);",
                  "   console.log(\"Token atualizado com sucesso!\");",
                  "} else {",
                  "   console.log(\"Nenhum token encontrado na resposta.\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@sorrisus.com\",\n  \"password\": \"admin123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        }
      ]
    },
    {
      "name": "Usuários",
      "item": [
        {
          "name": "Listar Usuários",
